# Local Tauri signing/build cache.
.tauri/

# Git-ignored internal reference docs (workflow D20/D21). Attach manually when needed.
internal-ref-files/

# Git-ignored local samples and scratch preview workspace.
examples/
.preview/

# Git-ignored root dev scripts (not part of npm test).
test-*.ts
test_*.ts
